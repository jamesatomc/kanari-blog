---
interface Props {
  href: string;
  imgSrc?: string;
  imgAlt?: string;
  title: string;
  description: string;
  index?: string;
  category?: string;
  action?: string;
}

const {
  href,
  imgSrc,
  imgAlt = "",
  title,
  description,
  index = "01",
  category = "SDK notes",
  action = "Read article",
} = Astro.props;
---

<a href={href} class="post-card">
  <div class="post-card__top">
    <span>{index}</span>
    <span>{category}</span>
  </div>
  {imgSrc && <div class="post-card__image"><img src={imgSrc} alt={imgAlt} loading="lazy" /></div>}
  <div class="post-card__copy">
    <h2>{title}</h2>
    <p>{description}</p>
    <strong>{action} <span aria-hidden="true">-&gt;</span></strong>
  </div>
</a>
