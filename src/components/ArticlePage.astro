---
import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";
import BlogPostLink from "./BlogPostLink.astro";
import ArchitectureFlow from "./ArchitectureFlow.astro";
import Layout from "../layouts/Layout.astro";

interface Props {
  title: string;
  description: string;
  contentHtml: string;
  previous?: {
    href: string;
    title: string;
    description: string;
    index: string;
  };
  next?: {
    href: string;
    title: string;
    description: string;
    index: string;
  };
  kicker?: string;
  meta?: string;
  showArchitectureFlow?: boolean;
}

const {
  title,
  description,
  contentHtml,
  previous,
  next,
  kicker = "SDK notes",
  meta = "Technical note",
  showArchitectureFlow = false,
} = Astro.props;
---

<Layout title={`${title} | Kanari Notes`} description={description}>
  <Navbar />
  <main>
    <header class="article-hero section-wrap">
      <p class="section-kicker">{kicker}</p>
      <h1>{title}</h1>
      <p>{description}</p>
      <a href="/" class="text-link"><span aria-hidden="true">&lt;-</span> All articles</a>
    </header>

    <article class="article-shell section-wrap">
      <div class="article-shell__meta">
        <span>Kanari Network</span>
        <span>{meta}</span>
      </div>
      {showArchitectureFlow && <ArchitectureFlow />}
      <div class="markdown-body" set:html={contentHtml} />
    </article>

    <section class="related-section section-wrap">
      <div>
        <p class="section-kicker">Article navigation</p>
        <h2>Keep exploring.</h2>
      </div>
      <div class="article-navigation">
        {previous && (
          <BlogPostLink
            href={previous.href}
            title={previous.title}
            description={previous.description}
            index={previous.index}
            category="Previous"
            action="Previous article"
          />
        )}
        {next && (
          <BlogPostLink
            href={next.href}
            title={next.title}
            description={next.description}
            index={next.index}
            category="Next"
            action="Next article"
          />
        )}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
