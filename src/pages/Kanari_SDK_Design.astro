---
import ArticlePage from "../components/ArticlePage.astro";
import { processMarkdown } from "../utils/markdownProcessor";

const post = await Astro.glob("../content/Kanari_SDK_Design.md");
const contentHtml = await processMarkdown(post[0].rawContent());
---

<ArticlePage
  title="Kanari SDK Design"
  description="A closer look at the nodes and design principles that shape the Kanari SDK."
  contentHtml={contentHtml}
  relatedHref="/Kanari_SDK_Implementation"
  relatedTitle="Kanari SDK Implementation"
  relatedDescription="A practical walkthrough for rendering and presenting SDK documentation."
  relatedIndex="02"
/>
