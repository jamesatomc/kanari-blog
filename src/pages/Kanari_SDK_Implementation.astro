---
import ArticlePage from "../components/ArticlePage.astro";
import { processMarkdown } from "../utils/markdownProcessor";

const post = await Astro.glob("../content/Kanari_SDK_Implementation.md");
const contentHtml = await processMarkdown(post[0].rawContent());
---

<ArticlePage
  title="Kanari SDK Implementation"
  description="A practical walkthrough for rendering and presenting SDK documentation."
  contentHtml={contentHtml}
  relatedHref="/Kanari_SDK_Design"
  relatedTitle="Kanari SDK Design"
  relatedDescription="Explore the core nodes and architectural ideas behind the Kanari SDK."
  relatedIndex="01"
/>
