---
import ArticlePage from "../components/ArticlePage.astro";
import { processMarkdown } from "../utils/markdownProcessor";

const post = await Astro.glob("../content/Kanari_SDK_Implementation.md");
const contentHtml = await processMarkdown(post[0].rawContent());
---

<ArticlePage
  title="Building with KanariClient"
  description="Use the Flutter and Dart facade for queries, signed transactions, and Move function calls."
  contentHtml={contentHtml}
  previous={{
    href: "/Kanari_SDK_Design",
    title: "Inside the Kanari SDK",
    description: "A map of the Rust workspace, Move runtime, DAG engine, RPC layers, and developer entry points.",
    index: "01",
  }}
  next={{
    href: "/Architecture",
    title: "Kanari DAG Architecture",
    description: "Follow a signed transaction through vertices, quorum decisions, checkpoints, canonical replay, and persistence.",
    index: "03",
  }}
/>
