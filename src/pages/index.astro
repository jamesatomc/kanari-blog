---
import BlogPostLink from "../components/BlogPostLink.astro";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Kanari Notes" description="Guides, design notes, and technical updates from Kanari Network.">
  <Navbar />
  <main>
    <section class="blog-hero section-wrap">
      <p class="section-kicker">Kanari notes</p>
      <h1>Ideas for an<br /><span>open network.</span></h1>
      <p>Guides, SDK design notes, and practical updates for people building with Kanari.</p>
    </section>

    <section class="articles-section section-wrap">
      <div class="section-heading">
        <p class="section-kicker">Latest updates</p>
        <h2>Read what is moving.</h2>
      </div>
      <div class="post-grid">
        <BlogPostLink
          href="/Kanari_SDK_Design"
          title="Inside the Kanari SDK"
          description="A map of the Rust workspace, Move runtime, DAG engine, RPC layers, and developer entry points."
          index="01"
        />
        <BlogPostLink
          href="/Kanari_SDK_Implementation"
          title="Building with KanariClient"
          description="Use the Flutter and Dart facade for queries, signed transactions, and Move function calls."
          index="02"
        />
        <BlogPostLink
          href="/Architecture"
          title="Kanari DAG Architecture"
          description="Follow a signed transaction through vertices, quorum decisions, checkpoints, canonical replay, and persistence."
          index="03"
          category="Architecture"
        />
        <BlogPostLink
          href="/DAG_Consensus_Layers"
          title="DAG Consensus Layers"
          description="Understand application logic, execution, committee decisions, data availability, persistence, and sync."
          index="04"
          category="Consensus"
        />
      </div>
    </section>

    <section class="blog-cta section-wrap">
      <p class="section-kicker">Build with Kanari</p>
      <h2>Take the next idea<br /><span>on-chain.</span></h2>
      <a class="button button--dark" href="https://docs.kanarinetwork.site/" target="_blank" rel="noreferrer">Read the docs <span aria-hidden="true">-&gt;</span></a>
      <i aria-hidden="true"></i>
    </section>
  </main>
  <Footer />
</Layout>
